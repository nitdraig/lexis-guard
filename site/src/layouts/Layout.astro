---
import type { LandingCopy } from '../i18n/types';
import '../styles/global.css';

interface Props {
  copy: LandingCopy;
  alternateLang: 'en' | 'es';
}

const { copy, alternateLang } = Astro.props;
const { lang } = copy;
const base = import.meta.env.BASE_URL;
const alternateUrl = `${base}${alternateLang}/`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={copy.description} />
    <title>{copy.title} — Automated API auditing</title>
    <link rel="alternate" hreflang={alternateLang} href={alternateUrl} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={`${base}${lang}/`}>
          <span class="brand-mark" aria-hidden="true">&gt;_</span>
          <span>{copy.title}</span>
        </a>
        <a class="lang-switch" href={alternateUrl} hreflang={alternateLang}>
          {alternateLang === 'es' ? 'ES' : 'EN'}
        </a>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="wrap">
        <p>
          <a href="https://github.com/nitdraig/lexis-guard" rel="noopener" target="_blank">{copy.footer.github}</a>
          <span aria-hidden="true">·</span>
          <a href="https://excelso.xyz" rel="noopener" target="_blank">{copy.footer.excelso}</a>
        </p>
        <p class="license">{copy.footer.license}</p>
      </div>
    </footer>
  </body>
</html>
