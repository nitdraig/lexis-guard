# LexisGuard CLI — Environment Variables
# Copia este archivo a .env y completa los valores reales.
# NUNCA commitees .env al repositorio.

# Tokens de autenticacion para multi-auth (BOLA/BFLA testing)
LEXIS_USER_A_TOKEN=Bearer tok-standard-a
LEXIS_USER_B_TOKEN=Bearer tok-standard-b
LEXIS_ADMIN_TOKEN=Bearer tok-admin

# API key de proveedor de IA (solo si usas cloud; omitir para modo local/Ollama)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
